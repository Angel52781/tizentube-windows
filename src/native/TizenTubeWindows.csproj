<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>TizenTubeWindows</RootNamespace>
    <AssemblyName>TizenTubeHost</AssemblyName>
    <ApplicationIcon>../../assets/TizenTube.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <Version>0.1.0-preview.15</Version>
    <Authors>TizenTube Windows Contributors</Authors>
    <Company>TizenTube Windows Contributors</Company>
    <Product>TizenTube Windows</Product>
    <Description>Lightweight Windows host for YouTube with built-in AdBlock, SponsorBlock, and DeArrow using Microsoft Edge WebView2</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Angel52781/tizentube-windows</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>

  <!-- Always embed the complete YouTube mods and CSS into the host. A user can
       move TizenTubeHost.exe onto the Desktop without silently losing AdBlock,
       SponsorBlock, DeArrow or diagnostics. Build must run bundle_mods first. -->
  <ItemGroup>
    <EmbeddedResource Include="../../src/mods/tizentube.bundle.js" LogicalName="TizenTube.InjectedBundle" />
    <EmbeddedResource Include="../../src/ui/styles.css" LogicalName="TizenTube.InjectedStyles" />
    <EmbeddedResource Include="floating_player.js" LogicalName="TizenTube.FloatingPlayer" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="fixtures\watch.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
